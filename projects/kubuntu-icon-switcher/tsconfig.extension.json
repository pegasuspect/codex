{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "extension/dist",
    "rootDir": "extension-src"
  },
  "include": ["extension-src/**/*.ts"]
}
